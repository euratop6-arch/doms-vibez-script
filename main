local Players = game:GetService("Players")
local player = Players.LocalPlayer
local Lighting = game:GetService("Lighting")

-- GUI setup
local gui = Instance.new("ScreenGui")
gui.Name = "RetroWindow"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

-- MAIN WINDOW
local window = Instance.new("Frame")
window.Size = UDim2.new(0, 700, 0, 500)
window.Position = UDim2.new(0.15, 0, 0.1, 0)
window.BackgroundColor3 = Color3.fromRGB(212,208,200)
window.BorderSizePixel = 0
window.Active = true
window.Draggable = true
window.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = window

-- TOP BAR
local topBar = Instance.new("Frame")
topBar.Size = UDim2.new(1, 0, 0, 35)
topBar.BackgroundColor3 = Color3.fromRGB(15,45,150)
topBar.BorderSizePixel = 0
topBar.Parent = window

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -120, 1, 0)
title.Position = UDim2.new(0, 12, 0, 0)
title.BackgroundTransparency = 1
title.Text = "doms full vibe hub"
title.Font = Enum.Font.Arcade
title.TextSize = 18
title.TextColor3 = Color3.new(1,1,1)
title.TextXAlignment = Enum.TextXAlignment.Left
title.Parent = topBar

-- BUTTON HOLDER
local buttonHolder = Instance.new("Frame")
buttonHolder.Size = UDim2.new(0, 90, 1, 0)
buttonHolder.Position = UDim2.new(1, -95, 0, 0)
buttonHolder.BackgroundTransparency = 1
buttonHolder.Parent = topBar

local function makeButton(text, color)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 28, 0, 24)
    btn.BackgroundColor3 = color
    btn.Text = text
    btn.Font = Enum.Font.Arcade
    btn.TextSize = 16
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Parent = buttonHolder
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0,6)
    c.Parent = btn
    return btn
end

local minimize = makeButton("-", Color3.fromRGB(0,120,255))
minimize.Position = UDim2.new(0,0,0,5)

local close = makeButton("X", Color3.fromRGB(200,0,0))
close.Position = UDim2.new(0,60,0,5)

-- CONTENT AREA
local content = Instance.new("Frame")
content.Size = UDim2.new(1, -20, 1, -55)
content.Position = UDim2.new(0,10,0,45)
content.BackgroundColor3 = Color3.fromRGB(235,235,235)
content.BorderSizePixel = 0
content.Parent = window

local contentCorner = Instance.new("UICorner")
contentCorner.CornerRadius = UDim.new(0,10)
contentCorner.Parent = content

-- CATEGORY PANEL (LEFT)
local categories = Instance.new("Frame")
categories.Size = UDim2.new(0, 160, 1, -20)
categories.Position = UDim2.new(0,10,0,10)
categories.BackgroundColor3 = Color3.fromRGB(200,200,200)
categories.Parent = content

local catCorner = Instance.new("UICorner")
catCorner.CornerRadius = UDim.new(0,8)
catCorner.Parent = categories

-- RIGHT PANEL
local rightPanel = Instance.new("Frame")
rightPanel.Size = UDim2.new(1, -180, 1, -20)
rightPanel.Position = UDim2.new(0,170,0,10)
rightPanel.BackgroundColor3 = Color3.fromRGB(245,245,245)
rightPanel.Parent = content

local rightCorner = Instance.new("UICorner")
rightCorner.CornerRadius = UDim.new(0,8)
rightCorner.Parent = rightPanel

-- CREATE CATEGORY BUTTON
local function createCategory(name, y)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 35)
    btn.Position = UDim2.new(0,5,0,y)
    btn.Text = name
    btn.Font = Enum.Font.Arcade
    btn.TextSize = 16
    btn.BackgroundColor3 = Color3.fromRGB(220,220,220)
    btn.TextColor3 = Color3.new(0,0,0)
    btn.Parent = categories
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0,6)
    c.Parent = btn
    return btn
end

-- CATEGORY CONTENTS TABLE
local categoryContents = {}

-- ====================
-- SLIDER/DRAGGER FUNCTION
-- ====================
local function makeDragger(parent,labelText,min,max,posY,callback)
    local lbl = Instance.new("TextLabel")
    lbl.Text = labelText
    lbl.Size = UDim2.new(0,120,0,25)
    lbl.Position = UDim2.new(0,10,0,posY)
    lbl.BackgroundTransparency = 1
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = parent

    local dragFrame = Instance.new("Frame")
    dragFrame.Size = UDim2.new(0,200,0,20)
    dragFrame.Position = UDim2.new(0,140,0,posY+2)
    dragFrame.BackgroundColor3 = Color3.fromRGB(180,180,180)
    dragFrame.Parent = parent

    local handle = Instance.new("Frame")
    handle.Size = UDim2.new(0,10,1,0)
    handle.Position = UDim2.new(0,0,0,0)
    handle.BackgroundColor3 = Color3.fromRGB(0,150,255)
    handle.Parent = dragFrame

    local dragging = false
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
        end
    end)

    handle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local rel = math.clamp(input.Position.X - dragFrame.AbsolutePosition.X,0,dragFrame.AbsoluteSize.X)
            handle.Position = UDim2.new(0,rel,0,0)
            local val = min + (rel/dragFrame.AbsoluteSize.X)*(max-min)
            callback(val)
        end
    end)
end

-- ====================
-- Atmosphere Tab
-- ====================
local atmFrame = Instance.new("Frame")
atmFrame.Size = UDim2.new(1,0,1,0)
atmFrame.BackgroundTransparency = 1
atmFrame.Parent = rightPanel
categoryContents["Atmosphere"] = atmFrame

makeDragger(atmFrame,"Brightness",0,10,10,function(val) Lighting.Brightness = val end)
makeDragger(atmFrame,"Time of Day",0,24,50,function(val) Lighting.TimeOfDay = tostring(val)..":00:00" end)
makeDragger(atmFrame,"Fog Density",0,1,90,function(val) Lighting.FogEnd = 1000 Lighting.FogStart = 0 Lighting.FogDensity = val end)

-- ====================
-- Fog Tab
-- ====================
local fogFrame = Instance.new("Frame")
fogFrame.Size = UDim2.new(1,0,1,0)
fogFrame.BackgroundTransparency = 1
fogFrame.Parent = rightPanel
fogFrame.Visible = false
categoryContents["Fog"] = fogFrame

makeDragger(fogFrame,"Fog Start",0,500,10,function(val) Lighting.FogStart = val end)
makeDragger(fogFrame,"Fog End",0,2000,50,function(val) Lighting.FogEnd = val end)
makeDragger(fogFrame,"Fog Density",0,1,90,function(val) Lighting.FogDensity = val end)

-- ====================
-- CATEGORY BUTTONS
-- ====================
local catNames = {"Atmosphere","Fog"}
for i,name in ipairs(catNames) do
    local btn = createCategory(name,10+(i-1)*45)
    btn.MouseButton1Click:Connect(function()
        for k,v in pairs(categoryContents) do
            v.Visible = (k == name)
        end
    end)
end

-- MINIMIZE/CLOSE
local minimized = false
local originalSize = window.Size
minimize.MouseButton1Click:Connect(function()
    if not minimized then window.Size = UDim2.new(0,700,0,35) minimized = true
    else window.Size = originalSize minimized = false end
end)
close.MouseButton1Click:Connect(function() gui:Destroy() end)
