-- Bloom Toggle
local bloomToggle = Instance.new("TextButton")
bloomToggle.Text = "Toggle Bloom"
bloomToggle.Size = UDim2.new(0,150,0,25)
bloomToggle.Position = UDim2.new(0,10,0,yPos)
bloomToggle.BackgroundColor3 = Color3.fromRGB(0,150,255)
bloomToggle.TextColor3 = Color3.new(1,1,1)
bloomToggle.Parent = atmFrame
local bloomOn = false
bloomToggle.MouseButton1Click:Connect(function()
	bloomOn = not bloomOn
	if bloomOn then
		if not Lighting:FindFirstChild("Bloom") then
			local b = Instance.new("BloomEffect")
			b.Parent = Lighting
		end
	else
		local b = Lighting:FindFirstChild("Bloom")
		if b then b:Destroy() end
	end
end)
yPos = yPos + spacing

-- Apply Button
local applyBtn = Instance.new("TextButton")
applyBtn.Text = "Apply Atmosphere"
applyBtn.Size = UDim2.new(0,150,0,30)
applyBtn.Position = UDim2.new(0,10,0,yPos)
applyBtn.BackgroundColor3 = Color3.fromRGB(0,150,255)
applyBtn.TextColor3 = Color3.new(1,1,1)
applyBtn.Parent = atmFrame

applyBtn.MouseButton1Click:Connect(function()
	local brightness = tonumber(brightnessBox.Text)
	if brightness then
		Lighting.Brightness = math.clamp(brightness,0,10)
	end

	local timeOfDay = tonumber(timeBox.Text)
	if timeOfDay then
		Lighting.TimeOfDay = tostring(math.clamp(timeOfDay,0,24))..":00:00"
	end

	local fogDensity = tonumber(fogBox.Text)
	if fogDensity then
		Lighting.FogStart = 0
		Lighting.FogEnd = 1000
		Lighting.FogColor = Lighting.OutdoorAmbient
	end

	local colors = {}
	for num in string.gmatch(colorBox.Text,"%d+") do
		table.insert(colors, tonumber(num))
	end
	if #colors == 3 then
		Lighting.Ambient = Color3.fromRGB(colors[1],colors[2],colors[3])
	end
end)

